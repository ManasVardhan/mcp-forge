def rpc(method: str, params: dict[str, Any] | None = None, req_id: int = 1) -> dict[str, Any]:
    """Send one JSON-RPC request through a fresh server instance."""
    server = MCPServer()
    request = {"jsonrpc": "2.0", "id": req_id, "method": method, "params": params or {}}
    return asyncio.run(server.handle_request(request))


